# Copy to .env (never commit .env). Placeholders only.
APP_ENV=development
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/stock_scanner

# "yahoo" = free Yahoo Finance data (personal use only, no account needed).
# "mock"  = synthetic demo data for development. It is NEVER live market data.
MARKET_DATA_PROVIDER=yahoo
MARKET_DATA_API_KEY=

TIMEZONE=Asia/Kolkata
# Yahoo has no minute data until ~09:16, so the morning scan runs at 09:20.
MORNING_SCAN_TIME=09:20
AFTERNOON_SCAN_TIME=15:00
# Close-performance measurement job (after the 15:30 close)
PERFORMANCE_JOB_TIME=16:00

VOLUME_SCORE_WEIGHT=0.5
MOVEMENT_SCORE_WEIGHT=0.5

# Eligibility / data-quality thresholds
MAX_DATA_STALENESS_SECONDS=300
MIN_AVG_TRADED_VALUE_INR=5000000
MIN_UNIVERSE_COVERAGE=0.80
# Scan only the top N companies by market cap (100 large + 150 mid + 250 small)
MAX_UNIVERSE_RANK=500

# Bounded retries for transient provider failures
PROVIDER_MAX_RETRIES=3
PROVIDER_RETRY_BASE_DELAY_SECONDS=2

# Password your dad types to open the site (required when APP_ENV=production).
APP_PASSWORD=

# Admin endpoints are disabled unless this is set. Use a long random value.
ADMIN_API_KEY=

# Optional: POST JSON alerts here when a scan fails or data is stale
ALERT_WEBHOOK_URL=

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173
